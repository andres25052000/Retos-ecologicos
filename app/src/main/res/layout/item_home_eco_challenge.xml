<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/bg_challenge_card"
    android:padding="12dp"
    android:layout_marginBottom="8dp">

    <!-- Status icon -->
    <TextView
        android:id="@+id/tv_home_status"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:gravity="center"
        android:textSize="18sp"
        android:text="⭕" />

    <!-- Challenge icon -->
    <TextView
        android:id="@+id/tv_home_icon"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:gravity="center"
        android:textSize="20sp"
        android:layout_marginStart="4dp"
        android:background="@drawable/bg_eco_level_card"
        android:text="♻️" />

    <!-- Title and progress -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginStart="10dp">

        <TextView
            android:id="@+id/tv_home_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:text="Sin bolsas plásticas" />

        <TextView
            android:id="@+id/tv_home_progress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="11sp"
            android:textColor="@color/text_secondary"
            android:layout_marginTop="1dp"
            android:text="0 / 1 vez" />
    </LinearLayout>

    <!-- Points badge -->
    <TextView
        android:id="@+id/tv_home_pts"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="12sp"
        android:textStyle="bold"
        android:textColor="#10B981"
        android:text="+10" />

</LinearLayout>
